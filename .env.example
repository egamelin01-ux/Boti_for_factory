# Боты Telegram на европейской машине. Реальные значения — в .env (chmod 600),
# в репозиторий не попадают.

# ИИнна — напоминания клиентам в их чатах.
NOTIFY_BOT_TOKEN=""
# Секрет для обращений портала к ИИнне (порт 8787).
NOTIFY_API_SECRET=""

# ИИнокентий — чтение рабочих чатов, расшифровки, мост уведомлений сотрудникам.
READER_BOT_TOKEN=""
# @username владельца: по упоминанию распознаётся обращение к нему.
READER_OWNER_USERNAME=""
# Считать пингом любое чужое сообщение (аварийный режим).
READER_PING_ALL=""

# Мост «портал → ИИнокентий» для личных сообщений сотрудникам (порт 8788).
ASSISTANT_API_SECRET=""
# Куда бот подтверждает привязку сотрудника.
PORTAL_WEBHOOK_URL="https://app.content-ceh.ru/api/telegram/webhook"

# Владелец: id личного чата, туда идут сверка и напоминания о неотвеченном.
TELEGRAM_OWNER_ID=""

# Старый мост Claude Code в Telegram (служба выключена с 28.08.2026).
TELEGRAM_BOT_TOKEN=""
AGENT_WORK_DIR=""
CLAUDE_CODE_OAUTH_TOKEN=""
